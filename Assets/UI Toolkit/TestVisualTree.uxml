<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(125, 121, 121); display: flex;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; height: auto; align-content: auto; justify-content: space-between; align-self: auto; background-color: rgba(125, 121, 121, 0); display: flex; font-size: 64px;">
            <ui:Label text="Вопрос 1/10" name="QuestionsCount" />
            <ui:Label text="0:01" name="Timer" style="align-self: flex-start;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: column-reverse; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; background-color: rgba(125, 121, 121, 0); display: flex;">
            <ui:VisualElement name="ModeContainer" style="flex-direction: column;">
                <ui:Label name="QuestionText" text="Вопрос вопрос вопрос" style="flex-wrap: wrap; font-size: 64px; white-space: normal;" />
                <ui:TextField placeholder-text="Введите ответ..." name="AnswerField" style="font-size: 64px;" />
                <ui:Button text="Ответить" name="SubmitButton" style="font-size: 64px;" />
            </ui:VisualElement>
            <ui:VisualElement name="QuestionImage" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Texture/%D0%92%D0%BE%D0%BF%D1%80%D0%BE%D1%811.png?fileID=2800000&amp;guid=b9737493c7142554fb10661dec3b366d&amp;type=3#Вопрос1&quot;); -unity-slice-type: sliced; align-content: flex-start; flex-wrap: nowrap; flex-basis: auto; background-size: 100% 100%; top: auto; bottom: auto;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ResultPanel" style="flex-grow: 1; align-self: auto; display: none; align-items: auto; align-content: auto; overflow: visible; visibility: visible; justify-content: flex-start; background-color: rgb(101, 101, 101); -unity-text-align: upper-left;">
        <ui:Label text="Результаты" name="ResultsText" style="align-content: auto; align-items: auto; align-self: auto; justify-content: flex-start; flex-grow: 0; flex-shrink: 0; flex-basis: auto; -unity-text-align: middle-center; position: absolute; top: -1px; left: 0; transform-origin: left top; white-space: nowrap; right: 0; bottom: 1px; flex-wrap: wrap;" />
    </ui:VisualElement>
</ui:UXML>
