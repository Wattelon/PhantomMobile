            <ui:VisualElement name="Ultrasound" class="mode-container" style="display: none; flex-direction: column-reverse;">
                <ui:DropdownField label="Вариация" name="DropdownField-USAxis" index="0" choices="Слева,Центральная,Справа" style="display: none;"/>
