            <ui:DropdownField label="" choices="English,Русский,Português" index="0" name="DropdownField-Language" enabled="false" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 60%; visibility: hidden;"/>
            <ui:DropdownField label="" choices="Thyroid Gland,Torso" index="0" name="DropdownField-Model" enabled="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 40%; flex-grow: 1; display: none;"/>
