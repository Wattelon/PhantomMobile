  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7a95ee3ca0146d4eb4552437ae66073, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  questions:
  - Text: "\u0427\u0442\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043E
      \u043D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435?"
    Answers:
    - "\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043A\u0430"
    - "\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430"
    - "\u0436\u0435\u043B\u0435\u0437\u0430 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F"
    Image: {fileID: 2800000, guid: b9737493c7142554fb10661dec3b366d, type: 3}
  - Text: "\u041A\u0430\u043A\u043E\u0439 \u043F\u0435\u0440\u0435\u0448\u0435\u0435\u043A
      (isthmus) \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0434\u043E\u043B\u0438
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B?"
    Answers:
    - "\u0441\u0440\u0435\u0434\u043D\u0438\u0439"
    - "\u0441\u0440\u0435\u0434\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0448\u0435\u0435\u043A"
    Image: {fileID: 0}
  - Text: "\u041A\u0430\u043A\u0430\u044F \u043C\u043E\u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u043C\u043A\u0430?"
    Answers:
    - "\u0443\u0437\u0438"
    - "\u0443\u043B\u044C\u0442\u0440\u0430\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0435
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    Image: {fileID: 2800000, guid: b9737493c7142554fb10661dec3b366d, type: 3}
  - Text: "\u041A\u0430\u043A\u043E\u0439 \u043D\u0435\u0440\u0432 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0432 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438 \u043E\u0442 \u0437\u0430\u0434\u043D\u0435\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B \u0438 \u0435\u0433\u043E \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044E \u0433\u043E\u043B\u043E\u0441\u0430?"
    Answers:
    - "\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043E\u0440\u0442\u0430\u043D\u043D\u044B\u0439"
    - "\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043E\u0440\u0442\u0430\u043D\u043D\u044B\u0439
      \u043D\u0435\u0440\u0432"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u0423\u0417\u0418-\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043C\u0435\u043B\u043A\u0438\u0435 \u043A\u0430\u043B\u044C\u0446\u0438\u043D\u0430\u0442\u044B
      \u0432 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0435 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B. \u041A\u0430\u043A\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E?"
    Answers:
    - "\u0440\u0430\u043A"
    - "\u0440\u0430\u043A \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B"
    - "\u043F\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u043D\u044B\u0439 \u0440\u0430\u043A"
    Image: {fileID: 2800000, guid: 9b1000ddd97662b449f3d03fc8c82b92, type: 3}
  - Text: "\u041A\u0430\u043A\u043E\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435
      \u043A\u0440\u043E\u0432\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u0435
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
      \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0430\u0440\u0442\u0435\u0440\u0438\u044F\u043C\u0438?"
    Answers:
    - "\u0432\u0435\u0440\u0445\u043D\u0438\u0435 \u0438 \u043D\u0438\u0436\u043D\u0438\u0435
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0438"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u041A\u0422-\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
      \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430,
      \u043F\u043B\u043E\u0442\u043D\u043E \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u0435\u0442
      \u043A \u0442\u0440\u0430\u0445\u0435\u0435, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
      \u0435\u0435 \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u044E.
      \u041A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0435. \u041A\u0430\u043A\u043E\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E?"
    Answers:
    - "\u0434\u0438\u0444\u0444\u0443\u0437\u043D\u044B\u0439 \u0442\u043E\u043A\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0437\u043E\u0431"
    - "\u0443\u0437\u043B\u043E\u0432\u043E\u0439 \u0437\u043E\u0431"
    - "\u0443\u0437\u043B\u043E\u0432\u043E\u0439 \u0437\u043E\u0431 \u0441 \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u0435\u0439"
    Image: {fileID: 2800000, guid: 337e489e062d8d5499156f74eb1261ea, type: 3}
  - Text: "\u041A\u0430\u043A\u0438\u0435 \u043F\u0430\u0440\u0430\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435
      \u0436\u0435\u043B\u0435\u0437\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
      \u0437\u0430\u0434\u043D\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B?"
    Answers:
    - "\u0432\u0435\u0440\u0445\u043D\u0438\u0435"
    - "\u0432\u0435\u0440\u0445\u043D\u0438\u0435 \u043F\u0430\u0440\u0430\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435"
    - "\u0432\u0435\u0440\u0445\u043D\u0438\u0435 \u043F\u0430\u0440\u0430\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435
      \u0436\u0435\u043B\u0435\u0437\u044B"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u041C\u0420\u0422-\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u0432 T1-\u0432\u0437\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0445 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u0445
      \u0443\u0437\u0435\u043B \u0432 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u0435 \u0438\u043C\u0435\u0435\u0442 \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0439
      \u0441\u0438\u0433\u043D\u0430\u043B, \u0430 \u0432 T2-\u0432\u0437\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0445
      \u2013 \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439
      \u0441\u0438\u0433\u043D\u0430\u043B \u0441 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u043C\u0438
      \u0433\u0438\u043F\u043E\u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E\u0434\u043A\u0430.  \u041A\u0430\u043A\u043E\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C? "
    Answers:
    - "\u0440\u0430\u043A"
    - "\u0440\u0430\u043A \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B"
    Image: {fileID: 2800000, guid: 8c8048cf1ab76824fb84bd370b842d81, type: 3}
  - Text: "\u041A\u0430\u043A\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u043C\u0430\u0441\u0441\u0443
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
      \u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0443
      \u0442\u0438\u0440\u0435\u043E\u0438\u0434\u043D\u044B\u0445 \u0433\u043E\u0440\u043C\u043E\u043D\u043E\u0432?"
    Answers:
    - "\u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u0430\u044F"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u0423\u0417\u0418 \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0441\u043E\u043B\u0438\u0434\u043D\u044B\u0439 \u0433\u0438\u043F\u043E\u044D\u0445\u043E\u0433\u0435\u043D\u043D\u044B\u0439
      \u0443\u0437\u0435\u043B \u0441 \u043D\u0435\u0447\u0435\u0442\u043A\u0438\u043C\u0438
      \u043A\u043E\u043D\u0442\u0443\u0440\u0430\u043C\u0438, \u043C\u0438\u043A\u0440\u043E\u043A\u0430\u043B\u044C\u0446\u0438\u043D\u0430\u0442\u0430\u043C\u0438
      \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u0435\u0439 (\u0448\u0438\u0440\u0435,
      \u0447\u0435\u043C \u0432\u044B\u0448\u0435). \u041A\u0430\u043A\u0430\u044F
      \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043D\u0430 \u0437\u043B\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C?"
    Answers:
    - "\u0432\u044B\u0441\u043E\u043A\u0430\u044F"
    Image: {fileID: 2800000, guid: c7cdc4073af01244ebadd3572853cb55, type: 3}
  - Text: "\u041A\u0430\u043A\u0443\u044E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443
      \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
      \u0447\u0430\u0441\u0442\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430
      \u0423\u0417\u0418 \u043A\u0430\u043A \u0433\u0438\u043F\u0435\u0440\u044D\u0445\u043E\u0433\u0435\u043D\u043D\u0443\u044E?"
    Answers:
    - "\u043A\u043E\u043B\u043B\u043E\u0438\u0434"
    - "\u043A\u043E\u043B\u043B\u043E\u0438\u0434 \u0432 \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u0430\u0445"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u041A\u0422 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0435
      \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0430
      \u0432 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0435 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B, \u0441 \u043E\u0447\u0430\u0433\u0430\u043C\u0438
      \u0441 \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u043C \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435\u043C.
      \u0412 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0434\u043E\u043B\u0435\u0439
      \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0441 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438
      \u0438\u043D\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0446\u0438\u0438. \u041A\u0430\u043A\u043E\u0435
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u043E
      \u0434\u043B\u044F \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
      \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0438?"
    Answers:
    - "\u043C\u0440\u0442"
    - "\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E-\u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u0430\u044F
      \u0442\u043E\u043C\u043E\u0433\u0440\u0430\u0444\u0438\u044F"
    Image: {fileID: 2800000, guid: 4e916b171a3879947a7b475c3ff65e96, type: 3}
  - Text: "\u041A\u0430\u043A\u0430\u044F \u043C\u043E\u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u043B\u0443\u0447\u0448\u0435
      \u0432\u0441\u0435\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0434\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438 \u043A\u043E\u0441\u0442\u043D\u044B\u0445
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440, \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0438\u0445
      \u043A \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u0435?"
    Answers:
    - "\u043A\u0442"
    - "\u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u0430\u044F \u0442\u043E\u043C\u043E\u0433\u0440\u0430\u0444\u0438\u044F"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u0423\u0417\u0418-\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
      \u0434\u0438\u0444\u0444\u0443\u0437\u043D\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430,
      \u0441 \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439 \u044D\u0445\u043E\u0433\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u044B, \u0441 \u0444\u0438\u0431\u0440\u043E\u0437\u043D\u044B\u043C\u0438
      \u0442\u044F\u0436\u0430\u043C\u0438 \u0438 \u043F\u0441\u0435\u0432\u0434\u043E\u0443\u0437\u043B\u0430\u043C\u0438.
      \u041A\u0430\u043A\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E?"
    Answers:
    - "\u0442\u0438\u0440\u0435\u043E\u0438\u0434\u0438\u0442 \u0445\u0430\u0448\u0438\u043C\u043E\u0442\u043E"
    Image: {fileID: 2800000, guid: 5519f301ffebb0444ac3ccef6cd09d0c, type: 3}
  - Text: "\u041A\u0430\u043A\u043E\u0439 \u043E\u0440\u0433\u0430\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043A\u043F\u0435\u0440\u0435\u0434\u0438 \u043E\u0442 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B?"
    Answers:
    - "\u0442\u0440\u0430\u0445\u0435\u044F"
    Image: {fileID: 0}
  - Text: "\u041D\u0430 \u041A\u0422-\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u043F\u043E\u043B\u044E\u0441\u0435
      \u043F\u0440\u0430\u0432\u043E\u0439 \u0434\u043E\u043B\u0438 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
      \u0436\u0435\u043B\u0435\u0437\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0441 \u0447\u0435\u0442\u043A\u0438\u043C\u0438
      \u043A\u043E\u043D\u0442\u0443\u0440\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442. \u041A\u0430\u043A\u043E\u0435
      \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0435?"
    Answers:
    - "\u043A\u0438\u0441\u0442\u0430"
    Image: {fileID: 2800000, guid: 043731d78cc64324196b79312facf3a9, type: 3}
